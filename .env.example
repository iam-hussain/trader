# ─────────────────────────────────────────────────────────────────────────────
# Trader Daily — environment template. Copy to .env and fill what you have.
# Missing keys do not block Phase 1; they can be entered in Settings later.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
TZ=America/New_York

# Web (Next.js)
WEB_PORT=3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-long-random-string

# API (Fastify)
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000

# Quant (FastAPI / Python)
QUANT_PORT=8000
QUANT_PUBLIC_URL=http://localhost:8000

# ── Databases ───────────────────────────────────────────────────────────────
MONGO_URL=mongodb://trader:trader@localhost:27017/trader?authSource=admin&directConnection=true
MONGO_INITDB_ROOT_USERNAME=trader
MONGO_INITDB_ROOT_PASSWORD=trader

REDIS_URL=redis://localhost:6379

DUCKDB_PATH=./data/duckdb/trader.duckdb
PARQUET_DIR=./data/parquet

# ── LLM providers (optional; enter what you have) ───────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OLLAMA_HOST=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.1:8b
DEFAULT_LLM_PROVIDER=anthropic

# ── Market data (free; optional) ────────────────────────────────────────────
FRED_API_KEY=
NEWSAPI_KEY=
ALPHA_VANTAGE_KEY=
FINNHUB_KEY=
# SEC requires this: "Your Name your-email@domain.com"
SEC_EDGAR_USER_AGENT=

# ── Notifications (optional) ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Broker (Interactive Brokers) ────────────────────────────────────────────
# Run TWS or IB Gateway desktop locally. App connects to these ports.
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=42
IBKR_MODE=paper

# ── Risk defaults (overridden in Settings) ──────────────────────────────────
DEFAULT_ACCOUNT_SIZE_USD=25000
DEFAULT_MAX_RISK_PER_TRADE_PCT=1.0
DEFAULT_MAX_DAILY_LOSS_PCT=3.0
DEFAULT_MAX_TRADES_PER_DAY=5
