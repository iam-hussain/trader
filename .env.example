# ─────────────────────────────────────────────────────────────────────────────
# Trader Daily — environment template. Copy to .env and fill what you have.
# Missing keys do not block Phase 1; they can be entered in Settings later.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
TZ=America/New_York

# Web (Next.js)
WEB_PORT=3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-long-random-string

# API (Fastify)
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000

# Quant (FastAPI / Python)
QUANT_PORT=8000
QUANT_PUBLIC_URL=http://localhost:8000

# ── Databases ───────────────────────────────────────────────────────────────
MONGO_URL=mongodb://trader:trader@localhost:27017/trader?authSource=admin&directConnection=true
MONGO_INITDB_ROOT_USERNAME=trader
MONGO_INITDB_ROOT_PASSWORD=trader

REDIS_URL=redis://localhost:6379

DUCKDB_PATH=./data/duckdb/trader.duckdb
PARQUET_DIR=./data/parquet

# ── LLM providers (optional; enter what you have) ───────────────────────────
# Cloud providers — paste API keys (also configurable per-user in Settings).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Local: Ollama (https://ollama.com). Run `ollama serve`; pull a model with
# e.g. `ollama pull llama3.1:8b`. The Docker Compose "ollama" profile also
# bundles a containerised server on this port.
OLLAMA_HOST=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.1:8b

# Local: LM Studio (https://lmstudio.ai) — OpenAI-compatible server.
#   1. Open LM Studio → "Local Server" tab
#   2. Load a model (e.g. Llama-3.1-8B-Instruct, Qwen2.5-7B-Instruct)
#   3. Click "Start Server" — note the URL it prints (e.g. http://localhost:1234)
#   4. Put that URL below (WITHOUT the trailing /v1 — we append it)
# The default model used for briefs is whatever you typed in Settings or the
# "Run brief" dialog; LMSTUDIO_DEFAULT_MODEL below is just a documentation
# hint for the conventional name LM Studio uses ("local-model") when no
# explicit model is selected.
# NOTE: from inside the api container, use host.docker.internal (Mac/Windows)
# to reach LM Studio running on the host. localhost/127.0.0.1 resolves to
# the container itself, not your machine.
LMSTUDIO_HOST=http://host.docker.internal:1234
LMSTUDIO_DEFAULT_MODEL=local-model
# If your LM Studio server has auth enabled (the "Require API key" or JWT
# toggle in LM Studio's server settings), paste the bearer token here.
# Alternatively set it in the web UI: Settings → LM Studio → Key. Either
# location works; the DB-stored value (UI) takes precedence over env.
LMSTUDIO_API_KEY=
# Ollama supports auth in its enterprise edition; if yours requires a key
# set it here. Most local Ollama installs don't need this.
OLLAMA_API_KEY=

# Which provider the API defaults to when a brief is generated without an
# explicit override. Options: lmstudio | ollama | anthropic | openai | google
# Default is lmstudio: it's local, has no API cost, and supports JSON Schema
# structured output via the OpenAI-compatible /v1/chat/completions endpoint.
DEFAULT_LLM_PROVIDER=lmstudio

# ── Market data (free; optional) ────────────────────────────────────────────
FRED_API_KEY=
NEWSAPI_KEY=
ALPHA_VANTAGE_KEY=
FINNHUB_KEY=
# SEC requires this: "Your Name your-email@domain.com"
SEC_EDGAR_USER_AGENT=

# ── Notifications (optional) ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Broker (Interactive Brokers) ────────────────────────────────────────────
# Run TWS or IB Gateway desktop locally. App connects to these ports.
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=42
IBKR_MODE=paper

# ── Risk defaults (overridden in Settings) ──────────────────────────────────
DEFAULT_ACCOUNT_SIZE_USD=25000
DEFAULT_MAX_RISK_PER_TRADE_PCT=1.0
DEFAULT_MAX_DAILY_LOSS_PCT=3.0
DEFAULT_MAX_TRADES_PER_DAY=5

# ── BullMQ workers ──────────────────────────────────────────────────────────
# Set to "false" to skip starting workers (useful for tests + read-only API)
JOBS_ENABLED=true

# ── Auth bypass (dev only) ──────────────────────────────────────────────────
# When "true", the API's requireAuth middleware skips JWT verification and
# injects a fixed dev user (dev@local.test, auto-created on first request).
# Use this for local single-user development; NEVER set true in production.
AUTH_DISABLED=true
